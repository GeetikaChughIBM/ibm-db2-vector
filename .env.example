# IBM DB2 Connection Configuration

# DB2 Server Configuration
DB2_HOST=your-db2-host
DB2_PORT=50001
# Note: Use 50001 if SSL enabled, otherwise 50000
DB2_DATABASE=database-name

# Authentication
DB2_USER=user-name
DB2_PASSWORD=password

# SSL Configuration
# Set to 'true' to enable SSL/TLS connection
DB2_SSL=true
DB2_SSL_CERT=path/to/DB2_SSL.crt

# DB2 Table Configuration
DB2_TABLE=table_name

# File Ingestion Configuration
INPUT_FILE=./sample.txt

# Text Splitting Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Ollama Configuration
OLLAMA_URL=http://localhost:11434

# Embedding Model Configuration
# Options: 'nomic-embed-text:latest', 'mxbai-embed-large', 'all-minilm'
EMBEDDING_MODEL=nomic-embed-text:latest

# Retrieval Configuration
# Number of top similar results to return
TOP_K=5